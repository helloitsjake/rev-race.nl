APP_NAME=RevRace
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=https://www.rev-race.nl

APP_LOCALE=nl
APP_FALLBACK_LOCALE=nl
APP_FAKER_LOCALE=nl_NL

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=revrace
# DB_USERNAME=revrace_user
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

OPENAI_API_KEY=
# Pro- en topmodellen worden in code geblokkeerd (App\Support\AiModel).
OPENAI_MODEL=gpt-5.4-mini

MOLLIE_KEY=
MOLLIE_REDIRECT_URL=https://www.rev-race.nl/premium/bedankt
MOLLIE_WEBHOOK_URL=https://www.rev-race.nl/mollie/webhook

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# --- AI-kosten en misbruikbescherming ---
# Harde daglimiet voor de hele site in dollars. Is die bereikt, dan gaan er die dag geen
# AI-calls meer uit. $2.20 is ongeveer 2 euro, ruwweg 150 nieuwe motors per dag.
AI_DAILY_BUDGET_USD=2.20
# Bij welk deel van het dagbudget er een waarschuwingsmail uitgaat.
AI_BUDGET_WARNING_AT=0.5
# Hoeveel nieuwe motors een account per 24 uur mag laten opzoeken.
AI_LOOKUPS_PER_USER_PER_DAY=5
AI_ALERT_EMAIL=jake@helloitsme.online
# Token voor /ai-gebruik/{token}. Leeg = pagina bestaat niet. Genereer met:
#   php -r "echo bin2hex(random_bytes(24));"
AI_DASHBOARD_TOKEN=
# Zet /ai-migratie/{token} aan. Alleen tijdelijk aanzetten om migraties te draaien, daarna
# weer uit. Artisan draait niet op de server, vandaar deze route.
AI_ALLOW_REMOTE_MIGRATE=false
